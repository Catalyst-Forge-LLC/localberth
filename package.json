{
  "name": "localberth",
  "version": "0.2.2",
  "private": false,
  "type": "module",
  "description": "Local DNS for ports. Named TCP port leases for a local machine.",
  "license": "Apache-2.0",
  "author": "Catalyst Forge, LLC",
  "bin": {
    "localberth": "./bin/localberth.mjs"
  },
  "exports": {
    "./port": "./src/lib/port.ts"
  },
  "files": [
    "bin",
    "src",
    "static",
    "svelte.config.js",
    "vite.config.ts",
    "tsconfig.json",
    "LICENSE",
    "NOTICE",
    "README.md",
    "site/static/logo.png"
  ],
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "cli": "tsx src/cli/main.ts",
    "test": "tsx --test src/**/*.test.ts",
    "site:dev": "pnpm --dir site dev",
    "site:build": "pnpm --dir site build",
    "site:check": "pnpm --dir site check",
    "site:deploy": "pnpm --dir site run ship",
    "ship": "pnpm --dir site run ship"
  },
  "keywords": [
    "ports",
    "localhost",
    "leases",
    "firewall",
    "cli"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "tsx": "^4.20.5"
  },
  "devDependencies": {
    "@sveltejs/adapter-node": "^5.5.7",
    "@sveltejs/kit": "^2.70.0",
    "@sveltejs/vite-plugin-svelte": "^7.2.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.3.0",
    "aibreze": "^0.1.5",
    "svelte": "^5.56.6",
    "svelte-check": "^4.7.3",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "^8.1.5"
  }
}
